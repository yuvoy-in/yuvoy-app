# The traveller API. Production is https://api.yuvoy.in/v1; the local Go stack
# from yuvoy-api's scripts/dev-stack.sh serves :8099.
NEXT_PUBLIC_API_URL=http://localhost:8099/v1

# Set to "disabled" to bypass MSW and talk to the real local stack instead.
# Anything else (or unset) means mocks are on in development.
NEXT_PUBLIC_API_MOCKING=enabled

# PostHog. Optional — with no key the consent banner never appears and nothing
# is downloaded. EU host by default, matching the yuvoy-web project.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# The app is noindex everywhere until it takes the root domain (D-102).
# Flip this to "true" at the cutover.
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_SITE_URL=https://app.yuvoy.in
